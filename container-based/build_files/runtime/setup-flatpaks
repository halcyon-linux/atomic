#!/usr/bin/env bash
# halcyon build step — setup-flatpaks (flathub USER repo only)
# repo only (no flathub system repo, no fedora flatpaks — user policy).
# First-login behavior mirrors the blue-build default-flatpaks module
# (github.com/blue-build/modules, modules/default-flatpaks): remove the
# Fedora flatpak remote and any fedora-origin apps/runtimes, configure
# Flathub with remote-add --if-not-exists + remote-modify --enable, install
# with --noninteractive, and notify. The four transition apps install
# per-user at first login (MIGRATION §8.1: they become monorepo RPMs later;
# flatpak state lives in /var/home anyway).
set -euo pipefail
# shellcheck source=build_files/packages-lib
source /ctx/packages-lib
packages_validate
echo "::group::setup-flatpaks — flatpak package + user-repo wiring"
# the flatpak stack AND the per-user app lists both live in packages.json
readarray -t FLATPAK_PKGS < <(packages_for flatpak)
dnf5 -y --setopt=install_weak_deps=False install \
  "${FLATPAK_PKGS[@]}"

# --- build-time hygiene: the image must ship NO flatpak remotes at all ---
# (default-flatpaks practice: fedora remote removal via remote-delete; plus
# drop fedora-workstation-repositories which ships the fedora-flatpak remote)
flatpak remote-delete --system fedora --force 2>/dev/null || true
flatpak remote-delete --system fedora-testing --force 2>/dev/null || true
rm -rf /etc/flatpak/remotes.d /var/lib/flatpak /etc/flatpak/removes.d 2>/dev/null || true
if rpm -q fedora-workstation-repositories >/dev/null 2>&1; then
  dnf5 -y remove fedora-workstation-repositories
fi

mkdir -p /usr/libexec/halcyon-image

# Generate the first-boot script. The static body is written through a
# QUOTED heredoc — every $ and backslash below is literal — and the app
# lists from packages.json are appended as concrete lines afterwards.
cat > /usr/libexec/halcyon-image/flatpak-setup <<'BODY'
#!/usr/bin/env bash
# halcyon per-user flatpak setup — default-flatpaks (v2) module practices,
# restricted to USER scope and Flathub as the ONLY remote.
# GENERATED by setup-flatpaks; app lists baked from build_files/packages.json.
set -euo pipefail

# --- 1. Fedora flatpak remotes must not exist ---
flatpak remote-delete --user fedora --force 2>/dev/null || true
flatpak remote-delete --user fedora-testing --force 2>/dev/null || true
command -v fedora-third-party >/dev/null 2>&1 && fedora-third-party disable || true
while read -r app; do
  [ -n "$app" ] || continue
  flatpak remove --user --noninteractive --delete-data "$app" 2>/dev/null || true
done < <(flatpak list --user --app --columns=application,origin 2>/dev/null |
  awk -F'\t' '$2 ~ /fedora/ {print $1}')

# --- 2. Flathub is the ONLY remote (user scope) ---
flatpak remote-add --user --if-not-exists flathub \
  https://dl.flathub.org/repo/flathub.flatpakrepo --title=Flathub
flatpak remote-modify --user --enable flathub
BODY

# --- baked app lists from packages.json (flatpak.remove, then install) ---
# shellcheck disable=SC2129  # appends to the generated file are intentional
flatpak_apps remove | while read -r app; do
  echo "flatpak remove --user --noninteractive --delete-data '$app' 2>/dev/null || true"
done >> /usr/libexec/halcyon-image/flatpak-setup
flatpak_apps install | while read -r app; do
  echo "flatpak install --user --noninteractive --or-update flathub '$app'"
done >> /usr/libexec/halcyon-image/flatpak-setup

cat >> /usr/libexec/halcyon-image/flatpak-setup <<'TAIL'
notify-send "halcyon" "User flatpak installation finished." 2>/dev/null || true

# --- 3. final state check: flathub must be the only user remote ---
remotes="$(flatpak remotes --user --show-disabled 2>/dev/null | awk 'NF && $1 != "Name" {print $1}' | grep -v '^flathub$' || true)"
if [ -n "$remotes" ]; then
  echo "  FAIL  unexpected user flatpak remotes present: $remotes"
  exit 1
fi
TAIL
chmod 0755 /usr/libexec/halcyon-image/flatpak-setup

# user unit — wired --global in configure-system; runs once at first login
cat > /usr/lib/systemd/user/halcyon-flatpak-setup.service <<'UNIT'
[Unit]
Description=Install halcyon user flatpaks from flathub (transition until RPM conversion)
Wants=network-online.target
After=network-online.target
ConditionPathExists=!%h/.config/halcyon/.flatpak-done

[Service]
Type=oneshot
ExecStart=/usr/libexec/halcyon-image/flatpak-setup
ExecStartPost=/bin/sh -c 'mkdir -p %h/.config/halcyon && touch %h/.config/halcyon/.flatpak-done'
RemainAfterExit=yes

[Install]
WantedBy=default.target
UNIT
echo "::endgroup::"
