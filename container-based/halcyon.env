# halcyon image build parameters (image-template.env convention)

# output image name, same as the repo name
IMAGE_NAME=halcyon

# Fedora major version of the base image (also drives tag aliases)
FEDORA_VERSION=44

# github username/organisation
REPO_ORGANIZATION="aahsnr-work"

IMAGE_DESC="Lean Hyprland gaming desktop — fedora-bootc + p03 kernel + NVIDIA open (negativo17 userland) + noctalia greeter + ujust/uupd"
IMAGE_KEYWORDS="bootc,oci,linux,hyprland,gaming,nvidia,p03"

# fancy profile on https://artifacthub.io/
IMAGE_LOGO_URL="https://raw.githubusercontent.com/aahsnr-work/halcyon/container/system_files/shared/usr/share/backgrounds/halcyon/astronaut.png"
DEFAULT_TAG="latest"
