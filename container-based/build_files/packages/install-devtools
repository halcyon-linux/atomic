#!/usr/bin/env bash
# halcyon build step — install-devtools (Fedora brew-formula replacements)
# Fedora RPMs (MIGRATION §8.7). RPM copies keep PATH priority: the Homebrew
# payload (build_files/brew, next stage) APPENDS its bin dirs via
# environment.d + profile.d, so these RPMs win and brew only backfills what
# Fedora does not ship (bun, pixi, opencode — see the brew/Brewfile).
# chezmoi comes from the official Fedora repo (2.72 in F44) — blue-build
# chezmoi module parity is provided by the systemd user units, not the
# install source.
set -euo pipefail
echo "::group::install-devtools — brew-formula replacements (Fedora RPMs)"
# NOTE: lazygit/starship/yazi/zellij are NOT in Fedora 44 (verified in the
# 2026-09-19 CI-equivalent build) — all four come from Terra via install-terra
# (lazygit ships there under its Go name golang-github-jesseduffield-lazygit).
# bun/pixi/opencode publish no Fedora RPMs — they arrive via the baked
# Homebrew payload (build_files/brew/install-brew-bundle + Brewfile), which
# is exactly how the main branch shipped them (brew.yml, 22 formulas).
# shellcheck source=build_files/packages-lib
source /ctx/packages-lib
packages_validate

# Three Fedora groups, one transaction each: a bad name in one group must not
# abort the others (dnf5 aborts the whole transaction on one unresolvable
# argument), and the per-group INFO line attributes failures cleanly.
readarray -t CLI_PKGS < <(packages_for cli-tools)
echo "  INFO  installing ${#CLI_PKGS[@]} cli-tools: ${CLI_PKGS[*]}"
dnf5 -y --setopt=install_weak_deps=False install \
  "${CLI_PKGS[@]}"
echo "  OK    cli-tools rpm-verified"

readarray -t DEV_PKGS < <(packages_for devtools)
echo "  INFO  installing ${#DEV_PKGS[@]} devtools: ${DEV_PKGS[*]}"
dnf5 -y --setopt=install_weak_deps=False install \
  "${DEV_PKGS[@]}"
echo "  OK    devtools rpm-verified"

readarray -t MISC_PKGS < <(packages_for misc)
echo "  INFO  installing ${#MISC_PKGS[@]} misc: ${MISC_PKGS[*]}"
dnf5 -y --setopt=install_weak_deps=False install \
  "${MISC_PKGS[@]}"
echo "  OK    misc rpm-verified"

ALL_DEV_PKGS=("${CLI_PKGS[@]}" "${DEV_PKGS[@]}" "${MISC_PKGS[@]}")
for pkg in "${ALL_DEV_PKGS[@]}"; do
  rpm -q "${pkg%%.i686}" >/dev/null 2>&1 || {
    echo "  FAIL  devtools package not installed after transaction: ${pkg}"
    exit 1
  }
done
echo "::endgroup::"
