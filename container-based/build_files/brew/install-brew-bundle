#!/usr/bin/env bash
# halcyon build step — install-brew-bundle (Homebrew core + Brewfile formulas
# BAKED into a /usr payload; main-branch brew.yml semantics on a fedora-bootc
# base).
#
# What happens here (mirrors main's install-brew-bundle.sh, with the brew-core
# acquisition swapped in for the Bazzite base's /usr/share/homebrew.tar.zst):
#   1. Acquire the brew core prefix tarball:
#        a. PREFERRED — the pre-packaged checksum-verified tarball from the
#           ublue-os/packages GitHub releases (homebrew-x86_64.tar.zst), the
#           exact asset the blue-build brew module consumes.
#        b. FALLBACK — the official NONINTERACTIVE install.sh (blue-build
#           "direct-pull" mode) if the release assets are unreachable.
#   2. Stage the prefix at its FINAL runtime path /home/linuxbrew/.linuxbrew
#      (bottles are relocated to the prefix they are poured into — installing
#      into a scratch path and moving the tree would bake broken paths into
#      every formula; docs.brew.sh/Manpage — bottle relocation).
#   3. Run `brew bundle` as a throwaway non-root uid (brew refuses root) with
#      HOMEBREW_NO_AUTO_UPDATE=1 — the self-update-free, deterministic pour.
#   4. Verify every pour via Cellar/<name>/<version>/INSTALL_RECEIPT.json.
#   5. Repack the populated prefix to /usr/share/halcyon/brew-bundle.tar.zst.
#
# halcyon-brew-bundle.service extracts that payload at boot — pre-login and
# offline; the brew-bundle.service user unit remains as an online catch-up
# fallback at login.
#
# Why repack instead of shipping /var/home/linuxbrew in the layer: /var is
# runtime state — bootc seeds it from the image only on first provisioning,
# never when rebasing an existing system. A /usr payload + boot extraction
# works everywhere, exactly like ublue-os/brew's own homebrew.tar.zst +
# brew-setup.service mechanism.
set -euo pipefail

BREWFILE="/usr/share/ublue-os/homebrew/Brewfile"
PAYLOAD_DIR="/usr/share/halcyon"
PAYLOAD="${PAYLOAD_DIR}/brew-bundle.tar.zst"
PREFIX="/home/linuxbrew/.linuxbrew"
BREW_BIN="${PREFIX}/bin/brew"
# Throwaway uid for running brew (it refuses root). The prefix is chowned
# to 1000:1000 before repack, matching brew-setup.service's ownership.
BREW_UID=9000
BREW_HOME="/var/tmp/brew-build-home"
MAX_ATTEMPTS=3
RETRY_DELAY=20
# ublue-os/packages release assets (blue-build brew module, non-direct-pull)
ASSET_BASE="homebrew-x86_64"
STAGE_DIR="/tmp/hbrew-stage"

echo "::group::install-brew-bundle — payload inputs"
if [ ! -f "${BREWFILE}" ]; then
  echo "  FAIL  ${BREWFILE} missing — ship it via system_files/shared/usr/share/ublue-os/homebrew/Brewfile"
  echo "::endgroup::"
  exit 1
fi
formula_count=$(grep -cE '^[[:space:]]*brew "?[^" ]+"?' "${BREWFILE}" || true)
echo "  OK    ${BREWFILE} present (${formula_count} formulas)"
if [ "${formula_count}" -eq 0 ]; then
  echo "  FAIL  Brewfile parsed to 0 formulas — refusing to build an empty payload"
  echo "::endgroup::"
  exit 1
fi

# Casks are a macOS concept — on Linux they do not install, and a cask
# entry would otherwise be baked into the payload unverified. Fail loudly
# so the Brewfile stays formulas-only.
if grep -qE '^[[:space:]]*cask "' "${BREWFILE}"; then
  echo "  FAIL  ${BREWFILE} contains cask entries — casks are unsupported on Linux; use formulas only"
  echo "::endgroup::"
  exit 1
fi

# Brew hard requirements that must already be in the image at this stage:
#   zstd (tarball packing), gcc (formula postinstall assumptions), git + curl
#   (brew itself), jq (release-asset resolution below), setpriv (uid drop).
for tool in zstd gcc git curl jq setpriv tar; do
  command -v "${tool}" >/dev/null 2>&1 || {
    echo "  FAIL  required tool '${tool}' not on PATH — install it in an earlier stage"
    echo "::endgroup::"
    exit 1
  }
done
echo "  OK    required tools present (zstd/gcc/git/curl/jq/setpriv/tar)"
echo "::endgroup::"

# /var/tmp hosts transient staging dirs; the built image strips /var, so
# guarantee it exists with the canonical sticky mode (1777, matching the
# base and tmp.conf) before anything stages under it.
install -d -m 1777 /var/tmp

acquire_tarball() {
  # $1 = destination path for homebrew-x86_64.tar.zst
  local dest="$1"
  echo "--- Trying pre-packaged tarball from ublue-os/packages releases ---"
  # Select the NEWEST release that carries BOTH the tarball and its sha256
  # (the releases API lists newest-first). Merging every release's assets
  # into one map — the naive approach — lets the OLDEST release win, which
  # is exactly how a 2026-01 brew 5.0.9 (8 months stale) got selected once
  # and crashed pours with `undefined method '[]' for nil` (load_tab) against
  # current formula data.
  # Pair by ASSET NAME, not by array position: GitHub lists assets
  # alphabetically (sha256 sorts before tar.zst), so position-based pairing
  # silently downloads the sha256 file as the tarball (hit live — the
  # checksum "mismatch" was the sha256 of the sha256 file).
  local pair tarball_url sha_url
  if pair=$(curl -fLsS --retry 5 --max-time 60 \
      'https://api.github.com/repos/ublue-os/packages/releases?per_page=20' 2>/dev/null |
      jq -r '
        [ .[]
          | select( ([.assets[].name] | index("'"${ASSET_BASE}"'.tar.zst"))
                    and ([.assets[].name] | index("'"${ASSET_BASE}"'.sha256")) ) ][0]
        | .assets[]
        | select(.name == "'"${ASSET_BASE}"'.tar.zst" or .name == "'"${ASSET_BASE}"'.sha256")
        | "\(.name)\t\(.browser_download_url)"' 2>/dev/null) &&
     [ -n "${pair}" ]; then
    tarball_url=$(awk -F'\t' -v n="${ASSET_BASE}.tar.zst" '$1 == n {print $2}' <<<"${pair}")
    sha_url=$(awk -F'\t' -v n="${ASSET_BASE}.sha256" '$1 == n {print $2}' <<<"${pair}")
  fi
  if [ -n "${tarball_url:-}" ] && [ -n "${sha_url:-}" ]; then
    echo "--- Downloading ${tarball_url} ---"
    if curl -fLsS --retry 5 --create-dirs \
        -o "${dest}" "${tarball_url}" \
        -o "${dest}.sha256" "${sha_url}"; then
      echo "--- Verifying tarball checksum ---"
      expected=$(sed 's/ .*//' "${dest}.sha256")
      actual=$(sha256sum "${dest}" | sed 's/ .*//')
      if [ "${expected}" = "${actual}" ]; then
        echo "  OK    checksum verified (${expected:0:16}…)"
        return 0
      fi
      echo "  WARN  checksum MISMATCH (expected ${expected:0:16}…, got ${actual:0:16}…) — falling back"
      rm -f "${dest}" "${dest}.sha256"
    else
      echo "  WARN  tarball download failed — falling back"
    fi
  else
    echo "  WARN  could not resolve release assets from the GitHub API — falling back"
  fi
  return 1
}

acquire_direct_pull() {
  # blue-build brew module "direct-pull" mode: the official NONINTERACTIVE
  # installer, run with a scrubbed environment, then the tree is packed.
  # $1 = destination path for the packed tarball
  local dest="$1"
  echo "--- FALLBACK: official Homebrew install.sh (direct-pull) ---"
  curl -fLsS --retry 5 --create-dirs \
    "https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh" \
    -o /tmp/brew-install || return 1
  chmod +x /tmp/brew-install
  mkdir -p /var/home /var/roothome
  # /.dockerenv tells the installer it is inside a container (it refuses
  # otherwise); env --ignore-environment keeps host PATH oddities out.
  touch /.dockerenv
  local rc=0
  env --ignore-environment PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME=/home/linuxbrew \
    NONINTERACTIVE=1 /usr/bin/bash /tmp/brew-install || rc=$?
  rm -f /.dockerenv /tmp/brew-install
  [ "${rc}" -eq 0 ] || return 1
  echo "--- Packing the installed prefix ---"
  tar --zstd -cf "${dest}" -C / home/linuxbrew/.linuxbrew || return 1
  return 0
}

echo "::group::install-brew-bundle — acquire brew core tarball"
TARBALL=/var/tmp/homebrew-core.tar.zst
rm -f "${TARBALL}" "${TARBALL}.sha256"
if acquire_tarball "${TARBALL}"; then
  MODE="prepackaged"
elif acquire_direct_pull "${TARBALL}"; then
  MODE="direct-pull"
else
  echo "  FAIL  could not acquire a brew core tarball (release assets AND direct-pull failed)"
  echo "::endgroup::"
  exit 1
fi
echo "  OK    brew core acquired via ${MODE} ($(du -h "${TARBALL}" | cut -f1))"
echo "::endgroup::"

echo "::group::install-brew-bundle — stage base brew prefix"
# The bundle MUST run with the prefix at its final runtime path
# /home/linuxbrew/.linuxbrew: bottles are relocated at install time to
# whatever prefix they are poured into, so installing into a scratch path
# and moving the tree would bake broken paths into every formula
# (docs.brew.sh/Manpage — bottle relocation). The build container's /home
# is a symlink to var/home with NO /var/home behind it (dangling), so
# /var/home is created here if missing — and removed again after repack:
# the layer must not ship /var state (bootc seeds /var from the initial
# image only; bootc.dev/bootc/filesystem.html).
CREATED_VAR_HOME=0
if [ ! -d /var/home ]; then
  mkdir -p /var/home
  CREATED_VAR_HOME=1
  echo "  INFO  created /var/home (missing in the build container — /home symlink was dangling)"
fi
echo "--- Staging exactly as brew-setup.service does at first boot ---"
rm -rf /home/linuxbrew "${STAGE_DIR}"
mkdir -p "${STAGE_DIR}" /home/linuxbrew
tar --zstd -xf "${TARBALL}" -C "${STAGE_DIR}"
# The pre-packaged ublue tarball carries the home/linuxbrew/.linuxbrew layout
# (same as ublue-os/brew's brew-setup.service cp path); the direct-pull pack
# above produces the same layout by construction.
if [ ! -x "${STAGE_DIR}/home/linuxbrew/.linuxbrew/bin/brew" ]; then
  echo "  FAIL  staged tarball has no home/linuxbrew/.linuxbrew/bin/brew — unexpected layout"
  echo "::endgroup::"
  exit 1
fi
cp -R -n "${STAGE_DIR}/home/linuxbrew/.linuxbrew" /home/linuxbrew
rm -rf "${STAGE_DIR}" "${TARBALL}" "${TARBALL}.sha256"
echo "  OK    prefix staged at ${PREFIX} (final runtime path — correct bottle relocation)"
test -x "${BREW_BIN}" || { echo "  FAIL  ${BREW_BIN} missing after staging"; echo "::endgroup::"; exit 1; }
"${BREW_BIN}" --version | head -1 | sed 's/^/  INFO  brew /'

chown -R "${BREW_UID}:${BREW_UID}" /home/linuxbrew
mkdir -p "${BREW_HOME}"
chown -R "${BREW_UID}:${BREW_UID}" "${BREW_HOME}"
echo "  OK    prefix + HOME owned by uid ${BREW_UID} for the bundle run"
echo "::endgroup::"

echo "::group::install-brew-bundle — brew update (controlled CLI convergence)"
# The release tarball can lag HEAD by months; a stale CLI against CURRENT
# formula data crashes pours (`undefined method '[]' for nil` in
# utils/bottles.rb load_tab — hit live with the 2026-01 tarball). Run the
# update ONCE, deliberately, BEFORE any pour so the bundle runs on a current
# CLI: deterministic (no mid-run self-update, which is what
# HOMEBREW_NO_AUTO_UPDATE=1 protects against below) and skew-free.
update_env=(
  env HOME="${BREW_HOME}"
  HOMEBREW_NO_ANALYTICS=1
  HOMEBREW_NO_ENV_HINTS=1
)
update_ok=0
for attempt in 1 2 3; do
  echo "--- brew update attempt ${attempt}/3 ---"
  if setpriv --reuid="${BREW_UID}" --regid="${BREW_UID}" --clear-groups \
      "${update_env[@]}" \
      "${BREW_BIN}" update; then
    update_ok=1
    break
  fi
  echo "  WARN  brew update attempt ${attempt} failed"
  sleep "${RETRY_DELAY}"
done
if [ "${update_ok}" -ne 1 ]; then
  echo "  FAIL  brew update failed after 3 attempts — refusing to pour with a stale CLI"
  echo "::endgroup::"
  exit 1
fi
"${BREW_BIN}" --version | head -1 | sed 's/^/  INFO  brew CLI converged to /'
echo "::endgroup::"

echo "::group::install-brew-bundle — brew bundle (network, with retries)"
# HOMEBREW_NO_AUTO_UPDATE=1 is REQUIRED here, not an optimization: with
# auto-update enabled, brew self-updates the CLI in place before pouring.
# That mid-run CLI swap made pours nondeterministic on main (a CI build
# poured all 22 formulas yet the payload lacked INSTALL_RECEIPT.json for 3
# of them). Pinned to the tarball's known-good brew, pours are deterministic
# and receipts always land in the Cellar; formula versions lag the tarball
# by design and are converged on the installed system by brew-upgrade.timer.
# Primary invocation is the modern CLI (`brew bundle install`, Brewfile via
# HOMEBREW_BUNDLE_FILE); if it fails, the legacy pre-6 form is tried once
# before the attempt counts as failed — a guard against CLI interface churn.
# Output streams to console AND a log file (PIPESTATUS preserves brew's exit
# code through the tee; set +e keeps the failing pipeline from exiting under
# pipefail).
bundle_env=(
  env HOME="${BREW_HOME}"
  HOMEBREW_NO_AUTO_UPDATE=1
  HOMEBREW_NO_ANALYTICS=1
  HOMEBREW_NO_ENV_HINTS=1
  HOMEBREW_BUNDLE_FILE="${BREWFILE}"
  HOMEBREW_CACHE="${BREW_HOME}/.cache/Homebrew"
)
for attempt in $(seq 1 "${MAX_ATTEMPTS}"); do
  echo "--- brew bundle attempt ${attempt}/${MAX_ATTEMPTS} ---"
  BUNDLE_LOG="${BREW_HOME}/bundle-attempt-${attempt}.log"
  set +e
  setpriv --reuid="${BREW_UID}" --regid="${BREW_UID}" --clear-groups \
    "${bundle_env[@]}" \
    "${BREW_BIN}" bundle install 2>&1 | tee "${BUNDLE_LOG}"
  rc=${PIPESTATUS[0]}
  if [ "${rc}" -ne 0 ]; then
    echo "  WARN  modern 'brew bundle install' failed (rc=${rc}) — trying legacy invocation"
    setpriv --reuid="${BREW_UID}" --regid="${BREW_UID}" --clear-groups \
      "${bundle_env[@]}" \
      "${BREW_BIN}" bundle --no-lock --file="${BREWFILE}" 2>&1 | tee -a "${BUNDLE_LOG}"
    rc=${PIPESTATUS[0]}
  fi
  set -e
  if [ "${rc}" -eq 0 ]; then
    echo "  OK    brew bundle completed on attempt ${attempt}"
    break
  fi
  if [ "${attempt}" -eq "${MAX_ATTEMPTS}" ]; then
    echo "  FAIL  brew bundle failed after ${MAX_ATTEMPTS} attempts (log tail below)"
    tail -40 "${BUNDLE_LOG}" | sed 's/^/        /'
    echo "::endgroup::"
    exit 1
  fi
  echo "  WARN  attempt ${attempt} failed — retrying in ${RETRY_DELAY}s"
  sleep "${RETRY_DELAY}"
done
echo "::endgroup::"

echo "::group::install-brew-bundle — verify Cellar contents"
# A pour counts only when complete: every pour writes a
# Cellar/<name>/<version>/INSTALL_RECEIPT.json "tab".
missing=0
poured=0
while IFS= read -r name; do
  [ -z "${name}" ] && continue
  if ls "${PREFIX}/Cellar/${name}"/*/INSTALL_RECEIPT.json >/dev/null 2>&1; then
    ver=$(find "${PREFIX}/Cellar/${name}" -mindepth 1 -maxdepth 1 -printf '%f\n' | head -1)
    echo "  OK    Cellar/${name} (${ver}) poured (receipt present)"
    poured=$((poured + 1))
  else
    echo "  FAIL  Cellar/${name} missing or incomplete after brew bundle"
    missing=$((missing + 1))
  fi
# Cellar dirs are named by formula only — strip any "tap/" prefix and
# tolerate quoted or unquoted entries, so new Brewfile lines of any
# common style are picked up automatically.
done < <(sed -nE 's/^[[:space:]]*brew "?([^" ]+)"?.*/\1/p' "${BREWFILE}" | sed 's|^.*/||')
if [ "${missing}" -gt 0 ]; then
  echo "  FAIL  ${missing} formula(s) missing — refusing to repack"
  echo "::endgroup::"
  exit 1
fi
echo "  OK    all ${poured}/${formula_count} Brewfile formulas installed"
echo "::endgroup::"

echo "::group::install-brew-bundle — brew cleanup (slim the payload)"
# Standard brew hygiene before repack: scrub download caches and any
# superceded keg versions so the baked payload stays as small as the poured
# formulas allow. Tolerated failure — cosmetic, not correctness.
setpriv --reuid="${BREW_UID}" --regid="${BREW_UID}" --clear-groups \
  env HOME="${BREW_HOME}" HOMEBREW_NO_ANALYTICS=1 HOMEBREW_NO_ENV_HINTS=1 \
  "${BREW_BIN}" cleanup --prune=all >/dev/null 2>&1 \
  || echo "  WARN  brew cleanup failed (non-fatal)"
echo "  OK    brew cleanup done"
echo "::endgroup::"

echo "::group::install-brew-bundle — repack payload + cleanup"
chown -R 1000:1000 /home/linuxbrew

# Pack from a symlink-free staging path (tar arg paths must not depend on
# /home -> var/home symlink resolution) with the same home/linuxbrew/...
# layout the ublue tarball uses.
STAGE="/var/tmp/hbrew-pack"
rm -rf "${STAGE}"
mkdir -p "${STAGE}/home/linuxbrew"
mv "${PREFIX}" "${STAGE}/home/linuxbrew/.linuxbrew"
rm -rf /home/linuxbrew

# Drop the /var/home we created for staging — no /var state may ship in
# the layer. Only removed when WE created it this run.
if [ "${CREATED_VAR_HOME}" -eq 1 ]; then
  rm -rf /var/home
  echo "  OK    removed build-time /var/home (created for staging)"
fi

mkdir -p "${PAYLOAD_DIR}"
tar --zstd -cf "${PAYLOAD}" -C "${STAGE}" home
rm -rf "${STAGE}" "${BREW_HOME}"

entries=$(tar --zstd -tf "${PAYLOAD}" | wc -l)
echo "  OK    payload ${PAYLOAD} ($(du -h "${PAYLOAD}" | cut -f1), ${entries} entries)"

# The populated prefix must NOT ship in the layer: /var is runtime state.
if [ -e /home/linuxbrew ]; then
  echo "  FAIL  ${PREFIX} still present — would ship as /var state"
  echo "::endgroup::"
  exit 1
fi
echo "  OK    staging prefix removed — payload rides in /usr only"
echo "--- install-brew-bundle complete ---"
echo "::endgroup::"
